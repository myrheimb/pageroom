<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="pageroom"
        Arguments=""
        InstallLocation="C:\Program Files\Pageroom\Pageroom">
    </Installer>
    <PackageInformation
        PackageName="Pageroom"
        PackageDisplayName="Pageroom"
        PublisherName="CN=Pageroom"
        PublisherDisplayName="Pageroom"
        Version="0.1.0.0"
        PackageDescription="Desktop CMS for Hugo">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="io.github.myrheimb.pageroom"
                Description="Desktop CMS for Hugo"
                DisplayName="Pageroom"
                ExecutableName="pageroom"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Pageroom</DisplayName>
            <PublisherDisplayName>Pageroom</PublisherDisplayName>
            <Description>Desktop CMS for Hugo</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="pageroom.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
